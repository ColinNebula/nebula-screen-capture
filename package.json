{
  "name": "nebula-screen-capture",
  "version": "0.1.0",
  "type": "module",
  "main": "electron.cjs",
  "private": true,
  "homepage": "https://ColinNebula.github.io/nebula-screen-capture",
  "description": "Professional screen recording made simple - A modern, feature-rich screen recording PWA & Desktop App",
  "author": "Nebula 3D Dev",
  "license": "MIT",
  "dependencies": {
    "@stripe/stripe-js": "8.0.0",
    "@tauri-apps/api": "2.9.0",
    "@tauri-apps/plugin-dialog": "2.4.2",
    "@tauri-apps/plugin-fs": "2.4.4",
    "firebase": "12.5.0",
    "svelte": "4.2.20",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:installer": "powershell -ExecutionPolicy Bypass -File build-tauri-installer.ps1",
    "tauri:build:installer:clean": "powershell -ExecutionPolicy Bypass -File build-tauri-installer.ps1 -Clean",
    "tauri:build:installer:msi": "powershell -ExecutionPolicy Bypass -File build-tauri-installer.ps1 -Target msi",
    "tauri:build:installer:nsis": "powershell -ExecutionPolicy Bypass -File build-tauri-installer.ps1 -Target nsis",
    "tauri:test:installer": "powershell -ExecutionPolicy Bypass -File test-tauri-installer.ps1 -AutoDetect",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build -r https://github.com/ColinNebula/nebula-screen-capture.git",
    "clean": "rmdir /s /q build 2>nul & rmdir /s /q node_modules 2>nul",
    "clean:cache": "rmdir /s /q node_modules\\.cache 2>nul & rmdir /s /q node_modules\\.vite 2>nul",
    "fresh-start": "powershell -ExecutionPolicy Bypass -File clear-cache.ps1 && npm run dev",
    "verify:electron": "node scripts/verify-electron-build.cjs",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3001 && electron .\"",
    "electron:build": "npm run build && npm run verify:electron && electron-builder",
    "electron:build:win": "npm run build && npm run verify:electron && electron-builder --win",
    "electron:build:mac": "npm run build && npm run verify:electron && electron-builder --mac",
    "electron:build:linux": "npm run build && npm run verify:electron && electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:installer": "powershell -ExecutionPolicy Bypass -File build-installer.ps1",
    "build:installer:clean": "powershell -ExecutionPolicy Bypass -File build-installer.ps1 -Clean",
    "build:quick": "npm run build && npm run electron:build:win",
    "build:all": "npm run build && electron-builder -wml",
    "test:installer": "powershell -ExecutionPolicy Bypass -File test-installer.ps1",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:fix": "npm audit fix",
    "security:check": "node scripts/security-check.cjs",
    "security:full": "npm run security:audit && npm run security:check",
    "precommit": "npm run security:audit"
  },
  "eslintConfig": {
    "extends": []
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.52.4",
    "@sveltejs/vite-plugin-svelte": "3.1.2",
    "@tauri-apps/cli": "2.9.2",
    "@tauri-apps/cli-win32-x64-msvc": "2.9.2",
    "concurrently": "8.2.2",
    "electron": "28.3.3",
    "electron-builder": "24.13.3",
    "gh-pages": "^6.3.0",
    "svelte-preprocess": "5.1.4",
    "terser": "5.44.0",
    "vite": "5.4.20",
    "wait-on": "7.2.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  }
}
