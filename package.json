{
  "name": "nebula-screen-capture",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "homepage": "https://ColinNebula.github.io/nebula-screen-capture",
  "description": "Professional screen recording made simple - A modern, feature-rich screen recording PWA",
  "author": "Nebula 3D Dev",
  "license": "MIT",
  "dependencies": {
    "@stripe/stripe-js": "8.0.0",
    "svelte": "4.2.20",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build -r https://github.com/ColinNebula/nebula-screen-capture.git",
    "clean": "rmdir /s /q build 2>nul & rmdir /s /q node_modules 2>nul",
    "clean:cache": "rmdir /s /q node_modules\\.cache 2>nul",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:linux": "vite build && electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "eslintConfig": {
    "extends": []
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.52.4",
    "@sveltejs/vite-plugin-svelte": "3.1.2",
    "gh-pages": "^6.3.0",
    "svelte-preprocess": "5.1.4",
    "vite": "5.4.20",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  }
}
